{
  "manifest_version": 3,
  "name": "TCG Listing Assistant",
  "version": "0.4.0",
  "description": "Import TCGplayer Mobile App CSV exports and add cards to TCGplayer Seller Portal inventory.",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["https://store.tcgplayer.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://store.tcgplayer.com/admin/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open TCG Listing Assistant"
  }
}
